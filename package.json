{
  "name": "travian-attack-alert",
  "version": "1.0.2",
  "private": true,
  "description": "Testy node:test dla Travian - Alliance Attacks to Discord (src/ + dist). Bez zewnętrznych zależności.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PeterPage2115/Travian-Attack-Alert.git"
  },
  "bugs": {
    "url": "https://github.com/PeterPage2115/Travian-Attack-Alert/issues"
  },
  "homepage": "https://github.com/PeterPage2115/Travian-Attack-Alert#readme",
  "scripts": {
    "test": "npm run test:characterization && npm run test:offline && npm run test:tools && npm run test:artifact",
    "test:characterization": "node tools/run-characterization.cjs",
    "test:offline": "node --test test/offline/*.test.cjs test/pure-module-parity.test.cjs test/fixtures/performance/server.test.cjs",
    "test:browser": "node --test test/browser/*.test.cjs",
    "test:tools": "node --test test/tools/*.test.cjs",
    "test:e2e": "node tools/run-e2e.cjs --release",
    "test:artifact": "node --test test/artifact/*.test.cjs test/runtime-parity.test.cjs",
    "check": "npm run check:versions && npm run check:artifact && node test/tools/test-inventory-v2.cjs --baseline test/fixtures/contracts/test-suite-baseline.json --manifest test/fixtures/contracts/test-suite-manifest.json --receipt-dir test-results/suite-receipts",
    "check:release": "node tools/check-release.cjs",
    "release:prepare": "node tools/prepare-release.cjs",
    "release:check": "node tools/check-release-readiness.cjs",
    "build": "node tools/build.cjs",
    "backup": "node tools/backup.cjs",
    "rollback": "node tools/rollback.cjs",
    "check:versions": "node tools/check-versions.cjs",
    "check:artifact": "node tools/check-artifact.cjs",
    "check:test-inventory": "node test/tools/test-inventory-v2.cjs --baseline test/fixtures/contracts/test-suite-baseline.json --manifest test/fixtures/contracts/test-suite-manifest.json --receipt-dir test-results/suite-receipts",
    "check:types": "node tools/check-types-ratchet.cjs",
    "quality": "node tools/quality.cjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/node": "22.15.30",
    "esbuild": "0.28.2",
    "playwright": "1.63.0",
    "sharp": "^0.35.4",
    "tesseract.js": "^6.0.1",
    "typescript": "5.9.2",
    "yauzl": "^3.4.0"
  },
  "packageManager": "npm@10.9.3",
  "engines": {
    "node": ">=18"
  }
}
