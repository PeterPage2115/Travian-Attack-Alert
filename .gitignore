/release/
/release-determinism-*/
.dane/
.codegraph/
backups/
*.tsbuildinfo

# System / edytory
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# Środowiska lokalne
.env
.env.*
!.env.example

# UWAGA: NIGDY nie wersjonuj sekretów!
